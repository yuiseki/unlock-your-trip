{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unlock-your-trip",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "unlock-your-trip", "database_id": "1a03f1c2-33be-4f6d-a89c-ae1ae41aeaf4", "migrations_dir": "migrations" }
  ]
}
